G1_PAYLOAD_BASE64
/usr/bin/base64 -D -i "$g1_stage/payload.b64" -o "$g1_stage/payload.zip"
[[ "$(/usr/bin/shasum -a 256 "$g1_stage/payload.zip" | /usr/bin/awk '{print $1}')" == 'dbe7a01ee76ed87552cf6f358f2be843c6764971ce7e1442714a2ab83340aab8' ]] || { print -u2 'Встроенный архив повреждён. Установка остановлена.'; exit 1; }
/usr/bin/ditto -xk "$g1_stage/payload.zip" "$g1_stage/payload"
/bin/zsh "$g1_stage/payload/install/mac.zsh" "$@"
