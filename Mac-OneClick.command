G1_PAYLOAD_BASE64
/usr/bin/base64 -D -i "$g1_stage/payload.b64" -o "$g1_stage/payload.zip"
[[ "$(/usr/bin/shasum -a 256 "$g1_stage/payload.zip" | /usr/bin/awk '{print $1}')" == 'deddf8a4c388160b319a58b021cf680ac9e2ffcfd5b313cff3ae9a79436727f9' ]] || { print -u2 'Встроенный архив повреждён. Установка остановлена.'; exit 1; }
/usr/bin/ditto -xk "$g1_stage/payload.zip" "$g1_stage/payload"
/bin/zsh "$g1_stage/payload/install/mac.zsh" "$@"
