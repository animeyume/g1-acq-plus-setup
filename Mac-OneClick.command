G1_PAYLOAD_BASE64
/usr/bin/base64 -D -i "$g1_stage/payload.b64" -o "$g1_stage/payload.zip"
[[ "$(/usr/bin/shasum -a 256 "$g1_stage/payload.zip" | /usr/bin/awk '{print $1}')" == '18f479364f176f2f24788e9281f03f0c538668dba596e09f5856c796c292a04e' ]] || { print -u2 'Встроенный архив повреждён. Установка остановлена.'; exit 1; }
/usr/bin/ditto -xk "$g1_stage/payload.zip" "$g1_stage/payload"
/bin/zsh "$g1_stage/payload/install/mac.zsh" "$@"
